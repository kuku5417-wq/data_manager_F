# ================================================
# 앱 환경변수 템플릿 — data_manager_F (사내망 전용)
# 이 파일을 복사해 저장소들의 공통 상위 폴더 secret\.env 로 저장하고 실제 값을 채우세요.
# (앱이 상위 폴더의 secret\.env 를 자동 탐색하며, SHI_ENV_FILE 환경변수로 경로 강제 지정도 가능)
# (.env 는 절대 커밋 금지 — 실제 키/비밀번호 포함)
#
# ★ 사내망 고정본: 자동감지 없음(IS_INTERNAL=True). NAS_BASE_PATH 필수.
#   MySQL(소스) + MSSQL(jsh_* 전송) + Solar(OCR/LLM) + NAS 경로 + 회사 프록시.
# ================================================


# ================================================
# NAS 경로 (필수)
# NAS_BASE_PATH 미설정 시 앱 기동 거부.
# ================================================
NAS_BASE_PATH=\\nas서버\공유폴더
NAS_UPLOAD_PATH=\\nas서버\공유폴더\upload
NAS_PARQUET_PATH=\\nas서버\공유폴더\parquet
NAS_DUMMY_PATH=\\nas서버\공유폴더\dummy


# ================================================
# MySQL DB (소스 — shipinfo/pjtevnt/shipbbs 읽기)
# HOST 미설정 또는 YOUR_ 로 시작 시 parquet 폴백 자동 전환
# ================================================
DB_MYSQL_HOST=
DB_MYSQL_PORT=3306
DB_MYSQL_DATABASE=
DB_MYSQL_USER=
DB_MYSQL_PASSWORD=


# ================================================
# MSSQL 운영서버 (타겟 — jsh_* 전송)
# ODBC Driver 18 필요. 미설정 시 전송 휴면.
# 주의: 서버 호스트 키는 오타 그대로 DB_SEVER (DB_SERVER 폴백 존재)
# ================================================
DB_SEVER=
DB_PORT=1433
DB_NAME=
DB_USERNAME=
DB_PASSWORD=
DB_DRIVER=ODBC Driver 18 for SQL Server


# ================================================
# OCR API (사내 — SOLA / DoXA)
# ================================================
# DoXA (사내) - 비동기 REST. 제출 POST {URL} → task_id → GET {URL}/status/{task_id} 폴링
OCR_DOXA_API_KEY=
OCR_DOXA_API_URL=

# 사내망 sola - OpenAI SDK(vision). URL은 OpenAI 호환 base_url (예: http://호스트:포트/.../v1)
OCR_SOLAR_API_KEY=
OCR_SOLAR_API_URL=
OCR_SOLAR_MODEL=


# ================================================
# LLM API (사내 — SOLA 단일)
# ================================================
LLM_SOLAR_API_KEY=
LLM_SOLAR_API_URL=
LLM_SOLAR_MODEL=


# ================================================
# Proxy (사내망 — 외부 인터넷 호출용)
# 사내 서버(SOLA/DoXA/MySQL/MSSQL)는 코드에서 프록시 우회.
# ================================================
HTTP_PROXY=http://60.200.254.1:9090
HTTPS_PROXY=http://60.200.254.1:9090


# ================================================
# 기상청 API허브 (apihub.kma.go.kr)
# 키 발급: https://apihub.kma.go.kr → authKey (data.go.kr serviceKey와 다름)
# ================================================
WEATHER_API_KEY=여기에_기상청_API허브_authKey_입력
WEATHER_BASE_URL=https://apihub.kma.go.kr/api/typ02/openApi/VilageFcstInfoService_2.0
